{
  "name": "fast-srp-hap",
  "description": "Secure Remote Password (SRP)",
  "version": "2.0.4",
  "main": "lib/srp.js",
  "types": "lib/srp.d.ts",
  "scripts": {
    "clean": "rimraf lib && rimraf coverage && rimraf .nyc_output",
    "lint": "eslint src",
    "build": "npm run clean && tsc",
    "test": "vows lib/test/test_*.js --spec",
    "test-coverage": "nyc --reporter=lcovonly npm run test",
    "docs": "typedoc",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge/fast-srp.git"
  },
  "author": "Zarmack Tanen",
  "license": "MIT",
  "engines": {
    "node": ">=10.17.0"
  },
  "files": [
    "jsbn",
    "lib",
    "!lib/test",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.4",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vows": "^0.8.3"
  },
  "nyc": {
    "exclude": [
      "*/test",
      "jsbn"
    ]
  },
  "overrides": {
    "glob": "^14.0.6",
    "test-exclude": {
      "minimatch": "^11.0.9"
    }
  }
}
